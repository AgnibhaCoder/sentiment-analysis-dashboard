# Ignore local virtual environments
.venv/
venv/
env/

# Ignore Python bytecode / caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore git metadata
.git/
.gitignore

# Ignore local test caches & IDE files
.pytest_cache/
.vscode/
.idea/

# Ignore local large model binaries or artifacts if downloaded locally
*.bin
*.safetensors
*.onnx